#!/usr/bin/env bash
# Orb setup: install the bun version pinned in package.json ("packageManager")
# and dependencies, so fresh orbs start ready.
# Must stay non-interactive, idempotent, and fast on a warm filesystem.
set -euo pipefail

cd "$(dirname "$0")/.."

BUN_VERSION="$(sed -n 's/^[[:space:]]*"packageManager":[[:space:]]*"bun@\([^"]*\)".*/\1/p' package.json)"
if [[ -z "$BUN_VERSION" ]]; then
  echo "pinned bun version not found in package.json packageManager field" >&2
  exit 1
fi

if [[ -x "$HOME/.bun/bin/bun" && "$("$HOME/.bun/bin/bun" --version)" == "$BUN_VERSION" ]]; then
  echo "bun $BUN_VERSION already installed"
else
  echo "Installing bun $BUN_VERSION..."
  time curl -fsSL https://bun.sh/install | bash -s -- "bun-v$BUN_VERSION"
fi
export PATH="$HOME/.bun/bin:$PATH"

marker='# orb-setup: bun on PATH'
if ! grep -Fqx "$marker" "$HOME/.bash_profile" 2>/dev/null; then
  printf '\n%s\nexport PATH="$HOME/.bun/bin:$PATH"\n' "$marker" >> "$HOME/.bash_profile"
fi

echo "bun: $(bun --version)"

echo "Installing dependencies..."
time bun install --frozen-lockfile

echo "orb setup complete"
